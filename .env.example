# Создаётся автоматически командой ./setup.sh — вручную заполнять не нужно.
BOT_TOKEN=123456789:AA...        # токен от @BotFather
ADMIN_ID=123456789               # ваш Telegram ID — сюда приходят заявки на вывод
SUPPORT_USERNAME=your_username   # кнопка «Поддержка» в профиле
DOMAIN=1-2-3-4.sslip.io          # адрес мини-аппа (setup.sh подставит сам)
# Необязательно — ссылки в приветствии (по умолчанию уже стоят эти):
CHANNEL_URL=https://t.me/safroulette
CHAT_URL=https://t.me/safroulette_chat
