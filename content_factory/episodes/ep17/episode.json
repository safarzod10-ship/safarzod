  {"text": "Звонко разбилось окно школы. А на площадке было трое.", "emotion": "mystery", "cam": "wide", "boom": true, "shake": true,
   "acts": {"max": {"faceTo": [-1.5, -12], "face": "shock", "pose": "shock"}, "artem": {"faceTo": [-1.5, -12], "face": "shock"}, "timur": {"faceTo": [-1.5, -12], "face": "shock"}}},
