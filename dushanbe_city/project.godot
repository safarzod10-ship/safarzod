; DUSHANBE — city stage (new standalone Godot 4.7 project, built from scratch).

config_version=5

[application]

config/name="DUSHANBE"
config/description="DUSHANBE: 600x600 m city district (stage: city environment)."
config/version="0.4.0-perf"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.08, 0.08, 0.09, 1)
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/core/settings.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

[shader_globals]

veg_unshadowed={
"type": "float",
"value": 0.0
}
city_macro_detail={
"type": "float",
"value": 1.0
}
grass_center={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
grass_radius={
"type": "float",
"value": 30.0
}
city_night={
"type": "float",
"value": 0.0
}
city_wetness={
"type": "float",
"value": 0.0
}
water_player={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
veg_wind_dir={
"type": "vec2",
"value": Vector2(0.8, 0.6)
}
veg_wind_strength={
"type": "float",
"value": 0.3
}
veg_wind_speed={
"type": "float",
"value": 1.0
}

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
rendering_device/fallback_to_opengl3=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
mesh_lod/lod_change/threshold_pixels=1.0
occlusion_culling/use_occlusion_culling=true
textures/default_filters/anisotropic_filtering_level=3

[importer_defaults]

texture={
"compress/mode": 2,
"mipmaps/generate": true,
"detect_3d/compress_to": 0
}
