class_name TrafficGraph
extends RefCounted
## Read-only access to data/city/traffic.json (generated by dushanbe_city_src/tools/city/traffic.py):
## lanes, junction connectors, stop lines, light groups / phases, crossings, parking spots, bus stops.
## Stage 6 (NPC traffic) builds on this; nothing here moves or spawns anything.

const PATH := "res://data/city/traffic.json"

var data := {}
var lanes := {}            ## id -> lane dict
var succ := {}             ## lane id -> [{to, turn, connector}]


static func load_default() -> TrafficGraph:
	var g := TrafficGraph.new()
	if FileAccess.file_exists(PATH):
		g.data = JSON.parse_string(FileAccess.get_file_as_string(PATH))
		for l in g.data["lanes"]:
			g.lanes[l["id"]] = l
		for c in g.data["connectors"]:
			if not g.succ.has(c["from"]):
				g.succ[c["from"]] = []
			g.succ[c["from"]].append({"to": c["to"], "turn": c["turn"], "connector": c})
	return g


static func pts(a: Array) -> PackedVector3Array:
	var out := PackedVector3Array()
	for p in a:
		out.append(Vector3(p[0], p[1], p[2]))
	return out


## Nearest lane (by its points) to a world position, optionally only lanes heading along `dir`.
func nearest_lane(pos: Vector3, dir := Vector3.ZERO) -> String:
	var best := ""
	var bd := INF
	for id in lanes:
		var p := pts(lanes[id]["points"])
		for i in p.size() - 1:
			var q := Geometry3D.get_closest_point_to_segment(pos, p[i], p[i + 1])
			var d := q.distance_to(pos)
			if dir != Vector3.ZERO and (p[i + 1] - p[i]).normalized().dot(dir.normalized()) < 0.5:
				continue
			if d < bd:
				bd = d
				best = id
	return best


## Polyline of a route following the given lane ids (lanes + the connectors between them).
func route_points(route: Array) -> PackedVector3Array:
	var out := PackedVector3Array()
	for i in route.size():
		out.append_array(pts(lanes[route[i]]["points"]))
		if i + 1 < route.size():
			for s in succ.get(route[i], []):
				if s["to"] == route[i + 1]:
					out.append_array(pts(s["connector"]["points"]))
	return out


## Shortest (fewest lanes) route between two lanes over junction movements (BFS).
func route(from_id: String, to_id: String) -> Array:
	var prev := {from_id: ""}
	var q := [from_id]
	while not q.is_empty():
		var u: String = q.pop_front()
		if u == to_id:
			var r := []
			var c := u
			while c != "":
				r.push_front(c)
				c = prev[c]
			return r
		for s in succ.get(u, []):
			if not prev.has(s["to"]):
				prev[s["to"]] = u
				q.append(s["to"])
	return []
