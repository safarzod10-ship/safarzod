<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Jarvis" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/jarvis_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/jarvis_cyan</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Theme.Jarvis.Splash" parent="Theme.Jarvis">
        <item name="android:windowSplashScreenBackground">@color/jarvis_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/jarvis_bg</item>
    </style>
</resources>
