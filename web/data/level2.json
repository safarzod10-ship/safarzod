iAnimation":{"n":10,"c":3},"bikerAnimation":{"n":80,"c":2},"schoolAkariAnimation":{"n":4,"c":2},"bullyAnimation":{"n":6,"c":2},"friendAnimation":{"n":8,"c":2},"bikerClips":{"n":79,"c":1},"gakuAnimation":{"n":82,"c":2},"gakuIdle":["S:idle_00__9","S:idle_01__8","S:idle_02__5","S:idle_03__8","S:idle_04__2","S:idle_05__7"],"gakuWalk":["S:walk_00__13","S:walk_01__15","S:walk_02__13","S:walk_03__11","S:walk_04__2","S:walk_05__18","S:walk_06__16","S:walk_07__13"],"gakuThrow":["S:throw_00__3","S:throw_01__6","S:throw_02__4","S:throw_03__8","S:throw_04__3","S:throw_05__5","S:throw_06","S:throw_07","S:throw_08","S:throw_09"],"bikerBloodPool":{"n":15},"gakuApproachSpeed":2.0,"gakuThrowFps":10.0,"gakuStrikeFrame":3,"bikerSitDown":["S:Biker_Sitdown1_00","S:Biker_Sitdown1_01","S:Biker_Sitdown1_02","S:Biker_Sitdown1_03"],"bikerTakeoffSound":"A:Biker_HeavyTakeoff","bikerLandingSound":"A:Biker_TruckBedSlam","bikerDoubleJumpSeconds":1.25,"bikerFirstArcHeight":0.65,"bikerSecondArcHeight":1.2,"jumpTail":["S:Girl1_Jump_11","S:Girl1_Jump_12","S:Girl1_Jump_13","S:Girl1_Jump_14"],"openingDoor":["S:Akari_OpeningDoor_00","S:Akari_OpeningDoor_01","S:Akari_OpeningDoor_02","S:Akari_OpeningDoor_03"],"hurt":["S:Akari_Hurt_00","S:Akari_Hurt_01","S:Akari_Hurt_02"],"death":["S:Akari_Death_00","S:Akari_Death_01","S:Akari_Death_02","S:Akari_Death_03","S:Akari_Death_04"],"protection":["S:Girl1_Protection_00","S:Girl1_Protection_01","S:Girl1_Protection_02","S:Girl1_Protection_03"],"akariDialogue":["S:Girl1_Dialogue_00","S:Girl1_Dialogue_01","S:Girl1_Dialogue_02","S:Girl1_Dialogue_03","S:Girl1_Dialogue_04","S:Girl1_Dialogue_05","S:Girl1_Dialogue_06","S:Girl1_Dialogue_07","S:Girl1_Dialogue_08","S:Girl1_Dialogue_09","S:Girl1_Dialogue_10"],"bullyAttack":["S:Girl2_Attack_00","S:Girl2_Attack_01","S:Girl2_Attack_02","S:Girl2_Attack_03","S:Girl2_Attack_04","S:Girl2_Attack_05","S:Girl2_Attack_06","S:Girl2_Attack_07","S:Girl2_Attack_08"],"bullyWalk":["S:Girl2_Walk_00","S:Girl2_Walk_01","S:Girl2_Walk_02","S:Girl2_Walk_03","S:Girl2_Walk_04","S:Girl2_Walk_05","S:Girl2_Walk_06","S:Girl2_Walk_07","S:Girl2_Walk_08","S:Girl2_Walk_09","S:Girl2_Walk_10","S:Girl2_Walk_11"],"bullyIdle":["S:Girl2_Idle_00","S:Girl2_Idle_01","S:Girl2_Idle_02","S:Girl2_Idle_03","S:Girl2_Idle_04","S:Girl2_Idle_05","S:Girl2_Idle_06"],"bullyDialogue":["S:Girl2_Dialogue_00","S:Girl2_Dialogue_01","S:Girl2_Dialogue_02","S:Girl2_Dialogue_03","S:Girl2_Dialogue_04","S:Girl2_Dialogue_05"],"friendWalk":["S:Girl3_Walk_00","S:Girl3_Walk_01","S:Girl3_Walk_02","S:Girl3_Walk_03","S:Girl3_Walk_04","S:Girl3_Walk_05","S:Girl3_Walk_06","S:Girl3_Walk_07","S:Girl3_Walk_08","S:Girl3_Walk_09","S:Girl3_Walk_10","S:Girl3_Walk_11"],"friendIdle":["S:Girl3_Idle_00","S:Girl3_Idle_01","S:Girl3_Idle_02","S:Girl3_Idle_03","S:Girl3_Idle_04","S:Girl3_Idle_05"],"friendDialogue":["S:Girl3_Dialogue_00","S:Girl3_Dialogue_01","S:Girl3_Dialogue_02","S:Girl3_Dialogue_03","S:Girl3_Dialogue_04"],"bloodPool":{"n":11},"dialogueVisibility":{"n":85,"c":3},"blackVisibility":{"n":90,"c":3},"narrationVisibility":{"n":91,"c":2},"dialogueView":{"n":85,"c":4},"narrationLabel":{"n":91,"c":3},"impactFlash":{"n":89,"c":2},"sittingAndGestureFps":6.0,"attackFps":10.0,"lettersPerSecond":36.0,"autoAdvance":1,"autoAdvanceHold":3.0,"narrationLettersPerSecond":32.0,"narrationHold":2.8,"openingConversation":[{"speaker":"AKARI","text":"Who are you?"},{"speaker":"GAKU","text":"I was your father's boss."},{"speaker":"GAKU","text":"We made quite a team in the old days."},{"speaker":"GAKU","text":"Don't worry, kiddo. You'll go free as soon as your father comes back to work for me."},{"speaker":"AKARI","text":"Work for you?"},{"speaker":"GAKU","text":"You don't know anything about your father, do you?"},{"speaker":"GAKU","text":"He left more bodies in a single day than the rest of us could pile up in a month."},{"speaker":"GAKU","text":"I've watched killers work without flinching. The first time I saw your father in action, I threw up."},{"speaker":"GAKU","text":"The others respected me. Your father was the one they feared."},{"speaker":"GAKU","text":"Your father was a demon wearing a man's skin."}],"defiance":[{"speaker":"AKARI","text":"My father is a good person. He wouldn't hurt anyone."},{"speaker":"AKARI","text":"And he sure as hell won't work for your fat ass."}],"memoryIntroduction":[{"speaker":"AKARI","text":"My mother died giving birth to me."},{"speaker":"AKARI","text":"At school, they called me a curse. The bullying never stopped."}],"bullyTaunt":{"speaker":"GIRL 2","text":"I've been learning a few moves from my father. Who better to try them on than you?"},"bullyThreat":[{"speaker":"GIRL 2","text":"Tell anyone about this, and you\u2019ll regret it."},{"speaker":"GIRL 3","text":"Who\u2019s she going to tell? The cops? They\u2019re on your father\u2019s payroll."},{"speaker":"GIRL 3","text":"The principal won\u2019t do shit. He\u2019s terrified of him."},{"speaker":"GIRL 3","text":"And her dad? What\u2019s he going to do against Takeru? He\u2019d piss himself before he could throw a punch."},{"speaker":"GIRL 3","text":"Your father would crush hers without breaking a sweat."},{"speaker":"GIRL 3","text":"Come on. Let\u2019s go."}],"finalNarration":[{"speaker":"AKARI","text":"I was always such a pathetic burden to my father."},{"speaker":"AKARI","text":"He worked so hard for me. My mother died because of me... yet he never blamed me."},{"speaker":"AKARI","text":"Even when everyone treated me like I was worthless, he never hated me."},{"speaker":"AKARI","text":"Even though I looked just like my mother... he always loved me."},{"speaker":"AKARI","text":"I'm sorry, Dad. I didn't deserve you."}],"gakuReprimand":[{"speaker":"GAKU","text":"You think I couldn't have done that myself?"},{"speaker":"GAKU","text":"If I wanted her dead, I'd have used her to lure Zenji here\u2014then buried them both."},{"speaker":"GAKU","text":"I need him working for me. Tell me\u2014how does killing his daughter make that happen?"},{"speaker":"GAKU","text":"DO YOU THINK HE'LL WORK FOR ME NOW?"},{"speaker":"GAKU","text":"DO YOU THINK HE'LL EVEN SPEAK TO ME, YOU FOOL?!"}],"bikerExcuse":{"speaker":"TAKERU","text":"But, boss\u2026 she was disrespecting you. I thought\u2014"},"gakuDisbelief":{"speaker":"GAKU","text":"You thought?"},"gakuOrder":{"speaker":"GAKU","text":"You were given one job. Keep her alive."},"bikerPlea":{"speaker":"TAKERU","text":"Boss, wait\u2014"},"gakuFinalWarning":{"speaker":"GAKU","text":"She'd better still be breathing."}}},{"T":"mb","s":"HypoFangs.Sfx","e":1,"d":{}}]},{"n":"Takeru","p":-1,"t":[740.0611,2.0,0.0,1.5,1.5,0.0],"c":[null,{"T":"mb","s":"HypoFangs.Prologue.LevelOneBikerGuard","e":1,"d":{"visual":{"n":80,"c":1},"idle":["S:Biker_Idle_00","S:Biker_Idle_01","S:Biker_Idle_02","S:Biker_Idle_03"],"attack":["S:Biker_Attack_00","S:Biker_Attack_01","S:Biker_Attack_02","S:Biker_Attack_03","S:Biker_Attack_04","S:Biker_Attack_05"],"hurt":["S:Biker_Hurt_00","S:Biker_Hurt_01"],"death":["S:Biker_Death_00","S:Biker_Death_01","S:Biker_Death_02","S:Biker_Death_03","S:Biker_Death_04","S:Biker_Death_05"],"run":["S:Biker_Run_00","S:Biker_Run_01","S:Biker_Run_02","S:Biker_Run_03","S:Biker_Run_04","S:Biker_Run_05"],"punch":["S:Biker_Punch_00","S:Biker_Punch_01","S:Biker_Punch_02","S:Biker_Punch_03","S:Biker_Punch_04","S:Biker_Punch_05"],"attack2":["S:Biker_Attack2_00","S:Biker_Attack2_01","S:Biker_Attack2_02","S:Biker_Attack2_03","S:Biker_Attack2_04","S:Biker_Attack2_05","S:Biker_Attack2_06","S:Biker_Attack2_07"],"attack3":["S:Biker_Attack3_00","S:Biker_Attack3_01","S:Biker_Attack3_02","S:Biker_Attack3_03","S:Biker_Attack3_04","S:Biker_Attack3_05","S:Biker_Attack3_06","S:Biker_Attack3_07"],"jump":["S:Biker_Jump_00","S:Biker_Jump_01","S:Biker_Jump_02","S:Biker_Jump_03"],"doubleJump":["S:Biker_DoubleJump_00","S:Biker_DoubleJump_01","S:Biker_DoubleJump_02","S:Biker_DoubleJump_03","S:Biker_DoubleJump_04","S:Biker_DoubleJump_05"],"climb":["S:Biker_Climb_00","S:Biker_Climb_01","S:Biker_Climb_02","S:Biker_Climb_03",