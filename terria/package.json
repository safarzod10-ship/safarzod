{
  "name": "virtual-country-map",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive procedural continent map for a Telegram Mini App city-building game (map layer only).",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && node tools/build-regions.ts && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "map:preview": "node tools/render-preview.ts",
    "regions": "node tools/build-regions.ts",
    "server:dev": "wrangler dev --local --var DEV_AUTH:1 --test-scheduled",
    "server:typecheck": "tsc --noEmit -p server/tsconfig.json",
    "server:schema:local": "wrangler d1 execute terria --local --file server/schema.sql",
    "art": "node tools/art/catalog.mjs && node tools/blender/cut.mjs && node tools/art/pack.mjs public/models art/catalog/out art/blender/out"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.6",
    "pixi-viewport": "^7.0.3",
    "pixi.js": "^8.23.0",
    "simplex-noise": "^4.0.3",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261128.1",
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^22.20.7",
    "@types/three": "^0.187.0",
    "draco3dgltf": "^1.5.9",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.169.0"
  }
}
