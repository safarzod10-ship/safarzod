; Engine configuration file.
; DUSHANBE — Godot 4.7 project. Edit via the editor or by hand; keep keys sorted by section.

config_version=5

[application]

config/name="DUSHANBE"
config/description="Open-world 3D game set in Dushanbe, Tajikistan (Android)."
config/version="0.1.0-stage1"
run/main_scene="res://scenes/bootstrap/boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/project_settings_override="user://renderer_override.cfg"
boot_splash/bg_color=Color(0.08, 0.08, 0.09, 1)
config/icon="res://icon.svg"

[autoload]

SaveManager="*res://scripts/managers/save_manager.gd"
SettingsManager="*res://scripts/managers/settings_manager.gd"
AssetRegistry="*res://scripts/managers/asset_registry.gd"
PerformanceMonitor="*res://scripts/managers/performance_monitor.gd"
InputManager="*res://scripts/managers/input_manager.gd"
SceneLoader="*res://scripts/managers/scene_loader.gd"
GameManager="*res://scripts/core/game_manager.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

[shader_globals]

env_horizon_color={
"type": "color",
"value": Color(0.7, 0.8, 0.9, 1)
}
env_sun_direction={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
env_wetness={
"type": "float",
"value": 0.0
}
env_wind={
"type": "vec2",
"value": Vector2(0.6, 0.2)
}

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
mesh_lod/lod_change/threshold_pixels=1.0
